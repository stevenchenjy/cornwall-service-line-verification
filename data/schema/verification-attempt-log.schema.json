{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Anonymized verification attempt and review - draft intake contract v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "attempt_id",
    "case_id",
    "previous_attempt_id",
    "pws_id",
    "baseline_as_of",
    "attempt_date",
    "initial_public",
    "initial_customer",
    "reported_category_before",
    "action",
    "outcome",
    "public_after",
    "customer_after",
    "accepted_category_after",
    "acceptance_rule_ref",
    "decision_ref",
    "follow_up_required",
    "selection_reason",
    "preparation_minutes",
    "travel_minutes",
    "contact_field_minutes",
    "administration_review_minutes"
  ],
  "properties": {
    "attempt_id": {
      "type": "string"
    },
    "case_id": {
      "type": "string"
    },
    "previous_attempt_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "pws_id": {
      "type": "string"
    },
    "baseline_as_of": {
      "type": "string",
      "format": "date"
    },
    "attempt_date": {
      "type": "string",
      "format": "date"
    },
    "initial_public": {
      "type": "object",
      "required": [
        "reported_material",
        "evidence_status"
      ],
      "properties": {
        "reported_material": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_status": {
          "enum": [
            "unreviewed",
            "submitted",
            "accepted",
            "rejected"
          ]
        },
        "evidence_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "initial_customer": {
      "type": "object",
      "required": [
        "reported_material",
        "evidence_status"
      ],
      "properties": {
        "reported_material": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_status": {
          "enum": [
            "unreviewed",
            "submitted",
            "accepted",
            "rejected"
          ]
        },
        "evidence_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "reported_category_before": {
      "type": [
        "string",
        "null"
      ]
    },
    "action": {
      "enum": [
        "public_records",
        "resident_assisted",
        "field_public",
        "field_customer",
        "joint_field_visit",
        "classification_review",
        "evidence_review",
        "classification_correction"
      ]
    },
    "outcome": {
      "enum": [
        "evidence_returned",
        "no_response",
        "inconclusive",
        "access_failed",
        "cancelled",
        "classification_accepted",
        "classification_rejected",
        "classification_deferred"
      ]
    },
    "public_after": {
      "type": "object",
      "required": [
        "reported_material",
        "evidence_status"
      ],
      "properties": {
        "reported_material": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_status": {
          "enum": [
            "unreviewed",
            "submitted",
            "accepted",
            "rejected"
          ]
        },
        "evidence_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "customer_after": {
      "type": "object",
      "required": [
        "reported_material",
        "evidence_status"
      ],
      "properties": {
        "reported_material": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_status": {
          "enum": [
            "unreviewed",
            "submitted",
            "accepted",
            "rejected"
          ]
        },
        "evidence_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "accepted_category_after": {
      "type": [
        "string",
        "null"
      ]
    },
    "acceptance_rule_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "decision_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "follow_up_required": {
      "type": "boolean"
    },
    "selection_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "preparation_minutes": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "description": "Observed staff minutes; null means unavailable, never zero-fill."
    },
    "travel_minutes": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "description": "Observed staff minutes; null means unavailable, never zero-fill."
    },
    "contact_field_minutes": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "description": "Observed staff minutes; null means unavailable, never zero-fill."
    },
    "administration_review_minutes": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "description": "Observed staff minutes; null means unavailable, never zero-fill."
    },
    "decision_record_path": {
      "type": [
        "string",
        "null"
      ],
      "description": "Optional curated intake field; underlying record remains restricted. Never infer acceptance from this value alone."
    },
    "decision_record_sha256": {
      "type": [
        "string",
        "null"
      ],
      "description": "Optional curated intake field; underlying record remains restricted. Never infer acceptance from this value alone."
    },
    "supersedes_decision_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Retain the available superseded decision ID. Required and nonempty for accepted corrections; genuinely unavailable metadata may be null or omitted for rejected/deferred corrections. This value alone does not establish acceptance."
    },
    "correction_reason": {
      "type": [
        "string",
        "null"
      ],
      "description": "Retain the available correction reason. Required and nonempty for accepted corrections; genuinely unavailable metadata may be null or omitted for rejected/deferred corrections. Do not invent a reason to retain failed work."
    },
    "source_outcome": {
      "type": [
        "string",
        "null"
      ],
      "description": "Optional curated intake field; underlying record remains restricted. Never infer acceptance from this value alone."
    },
    "validation_error": {
      "type": [
        "string",
        "null"
      ],
      "description": "Optional curated intake field; underlying record remains restricted. Never infer acceptance from this value alone."
    },
    "validation_status": {
      "enum": [
        "pending",
        "validated",
        "not_applicable",
        null
      ]
    }
  },
  "description": "One attempted action including failures. Link repeated attempts with stable pseudonymous case IDs. No names, addresses, coordinates or free-text private notes. References are pseudonymous and underlying evidence remains restricted. Not yet a department-confirmed export specification. Resident submissions and evidence assessment can be separate actions. Classification accept/reject/defer always records effort; accepted decisions require a separately validated evidence bundle. Optional curated fields are populated by intake review rather than assumed to exist in original department exports. Accepted corrections require a superseded decision ID and reason; rejected/deferred correction attempts retain effort and available source/error values even when that metadata is genuinely unavailable.",
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "classification_correction"
          },
          "outcome": {
            "const": "classification_accepted"
          }
        },
        "required": [
          "action",
          "outcome"
        ]
      },
      "then": {
        "required": [
          "supersedes_decision_id",
          "correction_reason"
        ],
        "properties": {
          "supersedes_decision_id": {
            "type": "string",
            "minLength": 1
          },
          "correction_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
